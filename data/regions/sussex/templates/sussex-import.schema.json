{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navigator.invalid/schemas/sussex-import-v1.json",
  "title": "Sussex controlled regional import",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "services", "councils", "triage_routes", "scripts", "evidence_checklists", "sources", "governance_owners", "verification_assignments"],
  "properties": {
    "metadata": { "$ref": "#/$defs/metadata" },
    "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
    "councils": { "type": "array", "items": { "$ref": "#/$defs/council" } },
    "triage_routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
    "scripts": { "type": "array", "items": { "$ref": "#/$defs/content" } },
    "evidence_checklists": { "type": "array", "items": { "$ref": "#/$defs/content" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "governance_owners": { "type": "array", "items": { "$ref": "#/$defs/governance" } },
    "verification_assignments": { "type": "array", "items": { "$ref": "#/$defs/assignment" } }
  },
  "$defs": {
    "metadata": { "type": "object", "additionalProperties": false, "required": ["region_id", "revision", "status"], "properties": { "region_id": { "const": "sussex" }, "revision": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }, "status": { "const": "draft" }, "source_owner": { "type": ["string", "null"] }, "supplied_at": { "type": ["string", "null"], "format": "date-time" } } },
    "service": { "type": "object", "additionalProperties": false, "required": ["stable_id", "subregion", "name", "source_ids", "publication_status"], "properties": { "stable_id": { "type": "string", "pattern": "^srv_(esx|wsx|bnh)_[a-z0-9_]+$" }, "subregion": { "enum": ["east-sussex", "west-sussex", "brighton-hove"] }, "name": { "type": "string", "minLength": 1 }, "coverage_display": { "type": ["string", "null"] }, "structured_coverage": { "type": "array", "items": { "type": "string" } }, "contact_methods": { "type": "array", "items": { "type": "object" } }, "accessibility": { "type": "object" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }, "publication_status": { "const": "draft" } } },
    "council": { "type": "object", "additionalProperties": false, "required": ["stable_id", "subregion", "name", "source_ids", "publication_status"], "properties": { "stable_id": { "type": "string", "pattern": "^council_(esx|wsx|bnh)_[a-z0-9_]+$" }, "subregion": { "enum": ["east-sussex", "west-sussex", "brighton-hove"] }, "name": { "type": "string" }, "route_reference": { "type": ["string", "null"] }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "publication_status": { "const": "draft" } } },
    "route": { "type": "object", "additionalProperties": false, "required": ["stable_id", "subregion", "trigger", "target_id", "fallback_id", "source_ids", "publication_status"], "properties": { "stable_id": { "type": "string", "pattern": "^route_(esx|wsx|bnh)_[a-z0-9_]+$" }, "subregion": { "enum": ["east-sussex", "west-sussex", "brighton-hove"] }, "trigger": { "type": "string" }, "target_id": { "type": "string" }, "fallback_id": { "type": "string" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "publication_status": { "const": "draft" } } },
    "content": { "type": "object", "additionalProperties": false, "required": ["stable_id", "title", "body", "source_ids", "review_status"], "properties": { "stable_id": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" }, "source_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "review_status": { "const": "draft" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["stable_id", "title", "url", "publisher", "retrieved_at"], "properties": { "stable_id": { "type": "string", "pattern": "^src_(esx|wsx|bnh)_[a-z0-9_]+$" }, "title": { "type": "string" }, "url": { "type": "string", "format": "uri", "pattern": "^https://" }, "publisher": { "type": "string" }, "retrieved_at": { "type": "string", "format": "date" } } },
    "governance": { "type": "object", "additionalProperties": false, "required": ["subregion", "responsibility", "owner_reference", "status"], "properties": { "subregion": { "type": "string" }, "responsibility": { "type": "string" }, "owner_reference": { "type": "string" }, "status": { "enum": ["unassigned", "proposed", "approved"] } } },
    "assignment": { "type": "object", "additionalProperties": false, "required": ["subregion", "subject_type", "subject_id", "assignee_reference", "status"], "properties": { "subregion": { "type": "string" }, "subject_type": { "type": "string" }, "subject_id": { "type": "string" }, "assignee_reference": { "type": "string" }, "status": { "enum": ["unassigned", "assigned", "complete"] } } }
  }
}
